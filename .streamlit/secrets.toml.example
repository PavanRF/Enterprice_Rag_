# Copy to .streamlit/secrets.toml and fill in. NEVER commit the real file or paste secrets in chat.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "PASTE-A-RANDOM-64-CHAR-STRING"
client_id = "PASTE-GOOGLE-CLIENT-ID.apps.googleusercontent.com"
client_secret = "PASTE-GOOGLE-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
