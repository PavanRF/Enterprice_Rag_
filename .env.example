# Copy to .env and fill in. Never commit real keys. Real environment variables override this file.

# LLM. Leave GROQ_API_KEY empty to use the no-key fallback (quotes sources, no follow-up rewriting).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DAILY_BUDGET_USD=5.0

# Sign-in. "login" = username and password (default). "proxy" = identity from your SSO layer.
AUTH_MODE=login   # or: google (Google sign-in), proxy (SSO header)
AUTH_HEADER=X-Forwarded-User
